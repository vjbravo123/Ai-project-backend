# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Mongo
MONGO_URI=mongodb://localhost:27017/ai-backend

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Gemini / LangChain
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash

# News agent
NEWSAPI_KEY=your_newsapi_org_key_here

# Resend (email / OTP + revision reminders)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Revision Buddy <reminders@yourdomain.com>

# OTP settings
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Revision reminder cron (cron expression, default every 10 minutes)
REVISION_REMINDER_CRON=*/10 * * * *
